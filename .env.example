NODE_ENV=development
# Set true for the full local YouTube path; production enables it automatically.
POT_PROVIDER_ENABLED=false
# Optional local bgutil server path/port. The production container supplies its own path.
POT_PROVIDER_ENTRYPOINT=
POT_PROVIDER_PORT=4416
# Render supplies PORT in production. Keep 3001 for local API development.
PORT=3001
# Comma-separated exact browser origins. Use the Cloudflare Pages origin in production.
WEB_ORIGIN=http://localhost:5173
# Optional absolute executable paths. Leave blank to use PATH, then Windows WinGet discovery.
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
GALLERY_DL_PATH=
# Required for API-issued preview/download tokens. Use a unique random value of at least 32 characters.
DOWNLOAD_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional frontend build setting; keep analytics disabled unless explicitly enabled.
VITE_ANALYTICS_ENABLED=false
